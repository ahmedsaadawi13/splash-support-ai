# SplashSupportAI Environment Configuration

# Database
DB_HOST=localhost
DB_NAME=splash_support_ai
DB_USER=root
DB_PASS=

# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME=SplashSupportAI
BASE_URL=http://localhost

# Security
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

# File Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain

# AI Provider (Placeholder for future integration)
AI_PROVIDER=openai
AI_PROVIDER_KEY=your-api-key-here
AI_MODEL=gpt-4
AI_MAX_TOKENS=1000

# Email (Simulated for now)
EMAIL_FROM_ADDRESS=noreply@splashsupportai.com
EMAIL_FROM_NAME=SplashSupportAI

# Timezone
DEFAULT_TIMEZONE=UTC

# Pagination
ITEMS_PER_PAGE=25

# SLA Check Interval (minutes)
SLA_CHECK_INTERVAL=5
